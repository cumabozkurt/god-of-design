[codespell]
skip = ./node_modules,./site,./.git,./dist,./.agents,*.png,*.svg,*.tr.md,catalog.json
# Real words in this repo: Herat, Bund (Shanghai), rouge, te reo Māori, Turkish "siz",
# Vietnamese "nam", Gutenberg-diagram "fallow" areas.
ignore-words-list = herat,nam,bund,rouge,te,fallow,siz
# printf colour prefixes such as %sRolled
ignore-regex = %s[A-Z][a-z]+
